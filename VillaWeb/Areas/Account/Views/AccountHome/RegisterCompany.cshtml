@model RegisterCompanyDTO

@{
    Layout = "_Layout";
    ViewData["Title"] = "Register Company";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-primary text-white text-center py-3">
                    <h3 class="mb-0">
                        <i class="fas fa-building me-2"></i>Register Your Company
                    </h3>
                </div>
                <div class="card-body p-4">
                    <form asp-area="Account" asp-controller="AccountHome" asp-action="RegisterCompany" method="post" novalidate>
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <!-- Username -->
                        <div class="mb-3">
                            <label asp-for="UserName" class="form-label fw-semibold">
                                <i class="fas fa-user me-1"></i>Username
                            </label>
                            <input asp-for="UserName" class="form-control form-control-lg"
                                   placeholder="Enter a username for the company account" autocomplete="username" />
                            <span asp-validation-for="UserName" class="text-danger small"></span>
                        </div>

                        <!-- Company Name -->
                        <div class="mb-3">
                            <label asp-for="CompanyName" class="form-label fw-semibold">
                                <i class="fas fa-id-card me-1"></i>Company Name
                            </label>
                            <input asp-for="CompanyName" class="form-control form-control-lg"
                                   placeholder="Enter the official company name" autocomplete="organization" />
                            <span asp-validation-for="CompanyName" class="text-danger small"></span>
                        </div>

                        <!-- Email -->
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-semibold">
                                <i class="fas fa-envelope me-1"></i>Company Email Address
                            </label>
                            <input asp-for="Email" class="form-control form-control-lg"
                                   placeholder="Enter company email" autocomplete="email" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <!-- Phone Number -->
                        <div class="mb-3">
                            <label asp-for="PhoneNumber" class="form-label fw-semibold">
                                <i class="fas fa-phone me-1"></i>Company Phone Number
                            </label>
                            <input asp-for="PhoneNumber" class="form-control form-control-lg"
                                   placeholder="Enter company phone number" autocomplete="tel" />
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>
                        
                        <!-- Country & City Row -->
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Country" class="form-label fw-semibold">
                                    <i class="fas fa-globe-americas me-1"></i>Country
                                </label>
                                <input asp-for="Country" class="form-control form-control-lg"
                                       placeholder="Country" autocomplete="country-name" />
                                <span asp-validation-for="Country" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="City" class="form-label fw-semibold">
                                    <i class="fas fa-city me-1"></i>City
                                </label>
                                <input asp-for="City" class="form-control form-control-lg"
                                       placeholder="City" autocomplete="address-level2" />
                                <span asp-validation-for="City" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Commercial Registration Document URL -->
                        <div class="mb-3">
                            <label asp-for="CommercialRegistrationDocUrl" class="form-label fw-semibold">
                                <i class="fas fa-link me-1"></i>Commercial Registration Document URL
                            </label>
                            <input asp-for="CommercialRegistrationDocUrl" class="form-control form-control-lg"
                                   placeholder="Google Drive link to your Commercial Registration Document" autocomplete="url" />
                            <span asp-validation-for="CommercialRegistrationDocUrl" class="text-danger small"></span>
                        </div>

                        <!-- Password & Confirm Password Row -->
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Password" class="form-label fw-semibold">
                                    <i class="fas fa-lock me-1"></i>Password
                                </label>
                                <div class="input-group">
                                    <input asp-for="Password" class="form-control form-control-lg"
                                           placeholder="Enter password" autocomplete="new-password" />
                                    <button class="btn btn-outline-secondary" type="button"
                                            onclick="togglePassword('Password')">
                                        <i class="fas fa-eye" id="togglePasswordIcon"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="ConfirmPassword" class="form-label fw-semibold">
                                    <i class="fas fa-lock me-1"></i>Confirm Password
                                </label>
                                <div class="input-group">
                                    <input asp-for="ConfirmPassword" class="form-control form-control-lg"
                                           placeholder="Confirm password" autocomplete="new-password" />
                                    <button class="btn btn-outline-secondary" type="button"
                                            onclick="togglePassword('ConfirmPassword')">
                                        <i class="fas fa-eye" id="toggleConfirmPasswordIcon"></i>
                                    </button>
                                </div>
                                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Submit Button -->
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg py-3">
                                <i class="fas fa-building me-2"></i>Register Company
                            </button>
                        </div>

                        <!-- Login Link -->
                        <div class="text-center mt-3">
                            <p class="mb-0">Already have an account?
                                <a asp-action="Login" class="text-decoration-none fw-semibold">
                                    Sign in here
                                </a>
                            </p>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- JavaScript for Password Toggle -->
<script>
    function togglePassword(fieldId) {
        const passwordField = document.getElementById(fieldId);
        const iconId = fieldId === 'Password' ? 'togglePasswordIcon' : 'toggleConfirmPasswordIcon';
        const toggleIcon = document.getElementById(iconId);

        if (passwordField.type === 'password') {
            passwordField.type = 'text';
            toggleIcon.classList.remove('fa-eye');
            toggleIcon.classList.add('fa-eye-slash');
        } else {
            passwordField.type = 'password';
            toggleIcon.classList.remove('fa-eye-slash');
            toggleIcon.classList.add('fa-eye');
        }
    }
</script>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
