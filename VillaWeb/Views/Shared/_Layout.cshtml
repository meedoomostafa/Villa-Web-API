@using System.Security.Claims
@using VillaWebUtility

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - VillaWeb</title>
    
    <!-- SEO Meta Tags -->
    <meta name="description" content="@ViewData["Description"]" />
    <meta name="keywords" content="luxury villas, villa rentals, vacation homes, premium properties" />
    <meta name="author" content="VillaWeb" />

    <!-- Favicon -->
    <link rel="icon" href="/favicon.ico" type="image/x-icon">

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&family=Montserrat:wght@400;500;700&display=swap" rel="stylesheet">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header id="header" class="header sticky-top">
        <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold text-primary" asp-area="Customer" asp-controller="CustomerHome" asp-action="Index">
                    <i class="fas fa-home me-2"></i>VillaWeb
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#main-nav" aria-controls="main-nav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="main-nav">
                    <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            @if (User.Identity.IsAuthenticated && User.IsInRole(SD.CompanyRoleName))
                            {
                                <a class="nav-link" asp-area="Company" asp-controller="CompanyHome" asp-action="Index">Home</a>
                            }
                            else
                            {
                                <a class="nav-link" asp-area="Customer" asp-controller="CustomerHome" asp-action="Index">Home</a>
                            }
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="Customer" asp-controller="CustomerHome" asp-action="Privacy">Privacy</a>
                        </li>

                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="fas fa-user-circle me-1"></i> @User.Identity.Name
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="navbarDropdown">
                                    @{
                                        if (User.IsInRole(SD.AdminRoleName))
                                        {
                                            <li><a class="dropdown-item" asp-area="Admin" asp-controller="AdminHome" asp-action="Index">Admin Dashboard</a></li>
                                        }
                                        else if (User.IsInRole(SD.CompanyRoleName))
                                        {
                                            <li><a class="dropdown-item" asp-area="Company" asp-controller="CompanyHome" asp-action="Profile">My Profile</a></li>
                                            <li><a class="dropdown-item" asp-area="Company" asp-controller="Villa" asp-action="Index">Manage Villas</a></li>
                                            <li><a class="dropdown-item" asp-area="Company" asp-controller="Booking" asp-action="Index">Manage Bookings</a></li>
                                        }
                                        else 
                                        {
                                            <li><a class="dropdown-item" asp-area="Customer" asp-controller="CustomerHome" asp-action="Profile">My Profile</a></li>
                                        }
                                    }           
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" asp-area="Account" asp-controller="AccountHome" asp-action="Logout">Logout</a></li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="registerDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="fas fa-user-plus me-1"></i>Register
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="registerDropdown">
                                    <li><a class="dropdown-item" asp-area="Account" asp-controller="AccountHome" asp-action="RegisterCustomer">
                                        <i class="fas fa-user me-2"></i>Register as Customer
                                    </a></li>
                                    <li><a class="dropdown-item" asp-area="Account" asp-controller="AccountHome" asp-action="RegisterCompany">
                                        <i class="fas fa-building me-2"></i>Register as Company
                                    </a></li>
                                </ul>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-primary" asp-area="Account" asp-controller="AccountHome" asp-action="Login">Login</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="pb-3">
        @RenderBody()
    </main>

    <footer class="footer bg-dark text-white mt-auto py-5">
        <div class="container">
            <div class="row">
                <div class="col-lg-4 col-md-6 mb-4 mb-lg-0">
                    <h5 class="text-uppercase mb-4">VillaWeb</h5>
                    <p class="text-muted">Experience luxury living with our curated collection of premium villas. Your perfect getaway is just a click away.</p>
                </div>
                <div class="col-lg-2 col-md-6 mb-4 mb-lg-0">
                    <h5 class="text-uppercase mb-4">Links</h5>
                    <ul class="list-unstyled mb-0">
                        <li><a asp-area="Customer" asp-controller="CustomerHome" asp-action="Index" class="text-muted">Home</a></li>
                        <li><a asp-area="Company" asp-controller="Villa" asp-action="Index" class="text-muted">Villas</a></li>
                        <li><a asp-area="Customer" asp-controller="CustomerHome" asp-action="Privacy" class="text-muted">Privacy</a></li>
                    </ul>
                </div>
                <div class="col-lg-2 col-md-6 mb-4 mb-lg-0">
                    <h5 class="text-uppercase mb-4">Follow Us</h5>
                    <ul class="list-unstyled mb-0">
                        <li><a href="#" class="text-muted">Facebook</a></li>
                        <li><a href="#" class="text-muted">Twitter</a></li>
                        <li><a href="#" class="text-muted">Instagram</a></li>
                    </ul>
                </div>
                <div class="col-lg-4 col-md-6 mb-4 mb-lg-0">
                    <h5 class="text-uppercase mb-4">Newsletter</h5>
                    <p class="text-muted">Subscribe to our newsletter for the latest deals and updates.</p>
                    <form>
                        <div class="input-group mb-3">
                            <input type="email" class="form-control" placeholder="Your email" aria-label="Your email" aria-describedby="button-addon2">
                            <button class="btn btn-primary" type="button" id="button-addon2">Subscribe</button>
                        </div>
                    </form>
                </div>
            </div>
            <div class="text-center py-4 mt-4 border-top">
                <p class="text-muted mb-0">&copy; @DateTime.Now.Year VillaWeb. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
