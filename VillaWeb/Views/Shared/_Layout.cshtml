@using VillaWebUtility
@inject IHttpContextAccessor Accessor
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - VILLA | Luxury Villas</title>
    
    <!-- Meta Tags -->
    <meta name="description" content="Discover handpicked luxury villas. Browse, filter, and book your perfect getaway.">
    
    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Icon & CSS Libraries -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    
</head>
<body>
    <!-- Floating Navigation -->
    <header>
        <nav class="navbar-floating" id="navbar">
            <div class="navbar-content container-custom">
                <a class="brand" asp-area="Customer" asp-controller="CustomerHome" asp-action="Index">
                    <div class="brand-icon">
                        <i class="fas fa-gem"></i>
                    </div>
                    VILLA
                </a>
                
                <button class="nav-toggle" id="navToggle">
                    <i class="fas fa-bars"></i>
                </button>

                <ul class="nav-links" id="navLinks">
                    <li><a class="nav-link" asp-area="Customer" asp-controller="CustomerHome" asp-action="Index">
                        <i class="fas fa-home"></i>Home
                    </a></li>
                    <li><a class="nav-link" asp-area="Customer" asp-controller="CustomerHome" asp-action="Privacy">
                        <i class="fas fa-shield-alt"></i>Privacy
                    </a></li>
                    @{
                        var token = Accessor.HttpContext!.Request.Cookies[SD.AccessTokenKey];
                        var isAuthenticated = !string.IsNullOrEmpty(token);
                    }
                    @if (isAuthenticated)
                    {
                        <li><a class="nav-link" asp-area="Company" asp-controller="Villa" asp-action="Index">
                            <i class="fas fa-building"></i>Villas
                        </a></li>
                        <li><a class="nav-link" asp-area="Company" asp-controller="VillaNumber" asp-action="Index">
                            <i class="fas fa-hashtag"></i>Numbers
                        </a></li>
                        <li><a class="nav-link" asp-area="Company" asp-controller="Booking" asp-action="Index">
                            <i class="fas fa-calendar"></i>Bookings
                        </a></li>
                        <li><a class="nav-link" asp-area="Account" asp-controller="AccountHome" asp-action="Logout">
                            <i class="fas fa-sign-out-alt"></i>Logout
                        </a></li>
                    }
                    else
                    {
                        <li><a class="nav-link" asp-area="Account" asp-controller="AccountHome" asp-action="Register">
                            <i class="fas fa-user-plus"></i>Register
                        </a></li>
                        <li><a class="nav-link" asp-area="Account" asp-controller="AccountHome" asp-action="Login">
                            <i class="fas fa-sign-in-alt"></i>Login
                        </a></li>
                    }
                </ul>
            </div>
        </nav>
    </header>

    <!-- Main Content Area -->
    <div class="content-wrapper">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <!-- Footer -->
    <footer class="footer">
         <div class="container-custom">
            <div class="footer-grid">
                <div>
                    <div class="footer-brand-container">
                        <div class="footer-brand-icon">
                            <i class="fas fa-gem"></i>
                        </div>
                        <span class="footer-brand-text">VILLA</span>
                    </div>
                    <p class="footer-desc">
                        Luxury villas, curated for unforgettable stays. Revolutionizing property management with innovative solutions and exceptional service.
                    </p>
                    <div class="social-links">
                        <a href="#" class="social-link" aria-label="Facebook"><i class="fab fa-facebook-f"></i></a>
                        <a href="#" class="social-link" aria-label="Twitter"><i class="fab fa-twitter"></i></a>
                        <a href="#" class="social-link" aria-label="LinkedIn"><i class="fab fa-linkedin-in"></i></a>
                        <a href="#" class="social-link" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
                    </div>
                </div>
                
                <div>
                    <h6 class="footer-title">Company</h6>
                    <ul class="footer-links">
                        <li><a href="#">About</a></li>
                        <li><a href="#">Careers</a></li>
                        <li><a href="#">Contact</a></li>
                        <li><a href="#">Press</a></li>
                    </ul>
                </div>
                
                <div>
                    <h6 class="footer-title">Explore</h6>
                    <ul class="footer-links">
                        <li><a asp-area="Company" asp-controller="Villa" asp-action="Index">Villas</a></li>
                        <li><a href="#">Destinations</a></li>
                        <li><a href="#">Offers</a></li>
                        <li><a asp-area="Company" asp-controller="Booking" asp-action="Index">Bookings</a></li>
                    </ul>
                </div>
                
                <div>
                    <h6 class="footer-title">Legal</h6>
                    <ul class="footer-links">
                        <li><a asp-area="Customer" asp-controller="CustomerHome" asp-action="Privacy">Privacy</a></li>
                        <li><a href="#">Terms</a></li>
                        <li><a href="#">Cookies</a></li>
                        <li><a href="#">Support</a></li>
                    </ul>
                </div>
                
                <div>
                    <h6 class="footer-title">Stay Connected</h6>
                    <p style="color: var(--text-secondary); margin-bottom: 16px;">Get updates on new villas and luxury travel insights.</p>
                    <form class="newsletter-form">
                        <input type="email" class="newsletter-input" placeholder="Enter your email" required>
                        <button type="submit" class="newsletter-btn">
                            <i class="fas fa-paper-plane"></i>
                        </button>
                    </form>
                    <div style="color: var(--text-secondary); font-size: 14px; margin-top: 16px;">
                        <div class="footer-contact-item">
                            <i class="fas fa-envelope"></i>
                            contact@villa.com
                        </div>
                        <div class="footer-contact-item">
                            <i class="fas fa-phone"></i>
                            +1 (555) 123-4567
                        </div>
                    </div>
                </div>
            </div>
            
            <div class="footer-bottom">
                <div>
                    © @DateTime.Now.Year VILLA. All rights reserved. Built with ❤️ for luxury travel.
                </div>
                <div class="footer-badges">
                    <span class="badge success">
                        <i class="fas fa-shield-alt"></i>SSL Secured
                    </span>
                    <span class="badge primary">
                        <i class="fas fa-award"></i>Premium Service
                    </span>
                    <span class="badge">
                        <i class="fas fa-mobile-alt"></i>Mobile Ready
                    </span>
                </div>
            </div>
        </div>
    </footer>

    <!-- Back to Top -->
    <button class="back-to-top" id="backToTop" aria-label="Back to Top">
        <i class="fas fa-chevron-up"></i>
    </button>
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // --- Elements ---
            const navbar = document.getElementById('navbar');
            const navToggle = document.getElementById('navToggle');
            const navLinks = document.getElementById('navLinks');
            const backToTop = document.getElementById('backToTop');
            
            // --- Mobile Navigation ---
            if (navToggle) {
                navToggle.addEventListener('click', function() {
                    navLinks.classList.toggle('active');
                    const icon = navToggle.querySelector('i');
                    icon.className = navLinks.classList.contains('active') ? 'fas fa-times' : 'fas fa-bars';
                });
            }
            
            // --- Scroll Effects (Throttled) ---
            let ticking = false;
            function handleScroll() {
                const scrollTop = window.pageYOffset;
                if (navbar) {
                    navbar.classList.toggle('scrolled', scrollTop > 50);
                }
                if (backToTop) {
                    backToTop.classList.toggle('visible', scrollTop > 300);
                }
                ticking = false;
            }

            window.addEventListener('scroll', function() {
                if (!ticking) {
                    window.requestAnimationFrame(handleScroll);
                    ticking = true;
                }
            });

            // --- Back to Top Smooth Scroll ---
            if(backToTop) {
                backToTop.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
            }

            // --- Newsletter Form ---
            const newsletterForm = document.querySelector('.newsletter-form');
            if (newsletterForm) {
                newsletterForm.addEventListener('submit', function(e) {
                    e.preventDefault();
                    alert('Thank you for subscribing!');
                    this.querySelector('.newsletter-input').value = '';
                });
            }
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
